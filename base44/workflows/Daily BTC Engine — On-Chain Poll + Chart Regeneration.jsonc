{
  "name": "Daily BTC Engine \u2014 On-Chain Poll + Chart Regeneration",
  "description": "Daily at 9am CT: polls on-chain data (hash rate, treasury flows, realized cap), runs NETSSPLSM v2.1 Monte Carlo simulation, and saves serialized snapshot to ModelVault.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 14 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_btc_engine_on_chain_poll_chart_regeneration",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "modelVault",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "modelVault"
  }
}